<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Banking System</display-name>

    <!-- Enhanced Session Configuration for Security -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure> <!-- Set to true for production HTTPS -->
            <max-age>1800</max-age> <!-- 30 minutes -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/error.jsp</location>
    </error-page>

    <!-- Filter Definitions -->
    <!-- REQUEST LOGGER FILTER - Should be FIRST to log everything -->
    <filter>
        <filter-name>RequestLoggerFilter</filter-name>
        <filter-class>filter.RequestLoggerFilter</filter-class>
    </filter>
    <filter>
        <filter-name>MLThreatDetectionFilter</filter-name>
        <filter-class>filter.MLThreatDetectionFilter</filter-class>
    </filter>
    <filter>
       <filter-name>ProductionMLFilter</filter-name>
       <filter-class>filter.ProductionMLFilter</filter-class>
   </filter>
    

    

    <!-- Filter Mappings - EXACT ORDER MATTERS -->
    
    <!-- REQUEST LOGGER - FIRST to capture all requests -->
    <filter-mapping>
        <filter-name>RequestLoggerFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>MLThreatDetectionFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
       <filter-name>ProductionMLFilter</filter-name>
       <url-pattern>/*</url-pattern>
       <dispatcher>REQUEST</dispatcher>
   </filter-mapping>
    
    
   

    

    
    
    
    
</web-app>